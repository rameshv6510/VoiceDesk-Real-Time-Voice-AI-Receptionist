# Server Settings
HOST=0.0.0.0
PORT=7860
ENVIRONMENT=development

# Voice Pipeline Providers (Zero-Cost Setup: Groq + Deepgram Free Credits)
STT_PROVIDER=deepgram
TTS_PROVIDER=deepgram
LLM_PROVIDER=groq

# Provider API Keys (Both are 100% Free - NO Credit Card Required)
# 1. Groq (Free forever, ultra-fast Llama-3.3-70b): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Deepgram ($200 free credit automatically on signup, no credit card): https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional Paid Providers (Not needed for zero-cost)
OPENAI_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=

# Models
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=qwen/qwen3.8-27b
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=multi
DEEPGRAM_TTS_VOICE=aura-athena-en
SARVAM_TTS_VOICE=kavya
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=kn-IN

# Database
DATABASE_URL=sqlite:///./voice_desk.db
CHROMA_PERSIST_DIR=./chroma_data

# Clinic Config
CLINIC_CONFIG_PATH=./config/clinic.yaml
